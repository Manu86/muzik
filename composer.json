{
    "name": "muzik/muzik",
    "description": "Lecteur de musique web PHP et SQLite auto-hébergé",
    "type": "project",
    "license": "MIT",
    "require": {
        "james-heinrich/getid3": "^1.9",
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "lint": "@php vendor/bin/parallel-lint --exclude vendor src bin public tests config config.php config.local.example.php",
        "analyse": "@php vendor/bin/phpstan analyse --debug --memory-limit=512M",
        "test": "@php vendor/bin/phpunit",
        "cs-check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs-fix": "@php vendor/bin/php-cs-fixer fix --sequential",
        "quality": [
            "@lint",
            "@test",
            "@analyse",
            "@cs-check"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
